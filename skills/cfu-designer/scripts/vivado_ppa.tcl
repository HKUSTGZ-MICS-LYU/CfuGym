# Fixed, non-project Vivado 2025.2 whole-MiCoSoc flow. Inputs are DATA only.
# argv: private files.txt, fresh output directory, MHz, threads, approved part.
# Never source/eval HDL paths, user constraints, generated Tcl or manifest text.
if {$argc != 5} { error "Expected files, output, MHz, threads, part" }
lassign $argv files_manifest out frequency threads part
set out [file normalize $out]
if {![regexp {^xc[a-z0-9]+-[a-z0-9-]+$} $part]} { error "Invalid FPGA part token" }
if {[llength [get_parts -quiet $part]] != 1} { error "Unknown/unsupported FPGA part" }
if {![string is double -strict $frequency] || $frequency <= 0 || $frequency > 100000} {
    error "Invalid frequency"
}
if {![string is integer -strict $threads] || $threads < 1 || $threads > 64} {
    error "Invalid thread count"
}
set metrics [open [file join $out metrics.tsv] {WRONLY CREAT EXCL}]
fconfigure $metrics -encoding utf-8 -translation lf
proc metric {key value} {
    global metrics
    # Timing names/error messages may contain whitespace; TSV is exactly two columns.
    puts $metrics "$key\t[string map [list \t { } \r { } \n { }] $value]"
    flush $metrics
}
proc save_text {path text} {
    set f [open $path {WRONLY CREAT EXCL}]
    fconfigure $f -encoding utf-8 -translation lf
    puts $f $text
    close $f
}
proc one_port {name} {
    set ports [get_ports -quiet $name]
    if {[llength $ports] != 1} { error "Required port is absent/ambiguous: $name" }
    return $ports
}
proc timing_metric {prefix mode args} {
    global out
    # args comes ONLY from fixed calls below, never from argv or a file.
    set paths [get_timing_paths -delay_type $mode -max_paths 1 -nworst 1 \
                   -sort_by slack -no_report_unconstrained {*}$args]
    metric ${prefix}.exists [expr {[llength $paths] != 0}]
    if {[llength $paths] == 0} { return }
    # One worst path per endpoint. Refuse silent truncation at the hard cap.
    set failing [get_timing_paths -delay_type $mode -max_paths 1000000 -nworst 1 \
                     -sort_by slack -slack_lesser_than 0 -no_report_unconstrained {*}$args]
    if {[llength $failing] >= 1000000} { error "Negative path metrics truncated" }
    set worst_by_endpoint [dict create]
    foreach negative $failing {
        set endpoint [get_property ENDPOINT_PIN $negative]
        set slack [get_property SLACK $negative]
        if {![dict exists $worst_by_endpoint $endpoint] || $slack < [dict get $worst_by_endpoint $endpoint]} {
            dict set worst_by_endpoint $endpoint $slack
        }
    }
    set total 0.0
    dict for {endpoint slack} $worst_by_endpoint { set total [expr {$total + $slack}] }
    metric ${prefix}.total_negative_slack_ns $total
    metric ${prefix}.failing_endpoints [dict size $worst_by_endpoint]
    set path [lindex $paths 0]
    foreach {property suffix} {SLACK slack_ns DATAPATH_DELAY datapath_delay_ns \
                              STARTPOINT_PIN startpoint ENDPOINT_PIN endpoint} {
        metric ${prefix}.${suffix} [get_property $property $path]
    }
    report_timing -of_objects $paths -file [file join $out "${prefix}.rpt"]
}
proc absent_timing {prefix} {
    metric ${prefix}.exists 0
}
proc check_count {text key} {
    # check_timing's 2025.2 section headings, not diagnostic natural language.
    set pattern [format {checking\s+%s\s+\(([0-9]+)\)} $key]
    if {![regexp -nocase $pattern $text -> count]} { error "Missing check_timing count: $key" }
    return $count
}
metric vivado.version [version -short]
metric part $part
metric target_frequency_mhz $frequency
metric phase inputs
set result [catch {
    set_param general.maxThreads $threads
    set f [open $files_manifest r]
    fconfigure $f -encoding utf-8
    set files [split [string trimright [read $f] \n] \n]
    close $f
    if {[llength $files] == 0} { error "Empty hardware fileset" }
    set root [file normalize [file join $out inputs]]
    set dirs [list $root]
    foreach path $files {
        set normalized [file normalize $path]
        if {[string first "${root}/" $normalized] != 0 || ![file isfile $normalized]} {
            error "File outside private input root: $path"
        }
        lappend dirs [file dirname $normalized]
    }
    set dirs [lsort -unique $dirs]
    # readmem paths generated by SpinalHDL are relative to this private RTL root.
    cd $root
    foreach path $files {
        switch -- [string tolower [file extension $path]] {
            .v - .sv { read_verilog -sv $path }
            .vh - .svh - .bin - .mem - .hex - .dat { }
            default { error "Unsupported input file" }
        }
    }
    set_property include_dirs $dirs [current_fileset]
    # XDC is generated from FIXED text plus a numeric period, never user Tcl.
    set xdc [file join $out constraints.xdc]
    save_text $xdc [format {create_clock -name socCtrl_systemClk -period %.9f [get_ports socCtrl_systemClk]
set_false_path -from [get_ports socCtrl_asyncReset]
set_false_path -from [get_ports system_peripheral_uart_logic_uart_rxd]
set_false_path -to [get_ports system_peripheral_uart_logic_uart_txd]
set_property IOSTANDARD LVCMOS33 [get_ports]
} [expr {1000.0 / $frequency}]]
    read_xdc $xdc
    synth_design -top MiCoSoc -part $part -flatten_hierarchy none
    metric phase post_synth
    set cfu [get_cells -hierarchical -filter {REF_NAME == AgentCfu || ORIG_REF_NAME == AgentCfu}]
    metric cfu.instance_count [llength $cfu]
    if {[llength $cfu] != 1} { error "Expected exactly one AgentCfu hierarchy after synthesis" }
    set cfu_name [get_property NAME $cfu]
    metric cfu.instance $cfu_name
    one_port socCtrl_systemClk
    if {[llength [get_clocks socCtrl_systemClk]] != 1} { error "Synthesis target clock missing" }
    set reset [one_port socCtrl_asyncReset]
    set uart_rx [one_port system_peripheral_uart_logic_uart_rxd]
    set uart_tx [one_port system_peripheral_uart_logic_uart_txd]
    # Explicit asynchronous external interfaces. Do NOT false-path internal CFU logic.
    set allowed {socCtrl_systemClk socCtrl_asyncReset system_peripheral_uart_logic_uart_rxd system_peripheral_uart_logic_uart_txd}
    foreach port [get_ports] {
        if {[get_property NAME $port] ni $allowed} {
            error "Unconstrained unexpected SoC port: $port"
        }
    }
    # Electrical convention is in the XDC; no board-specific LOC or DRC waiver.
    report_exceptions -file [file join $out exceptions.rpt]
    write_checkpoint [file join $out post_synth.dcp]
    report_utilization -file [file join $out utilization_post_synth.rpt]
    report_utilization -cells $cfu -file [file join $out utilization_cfu_post_synth.rpt]
    report_timing_summary -delay_type min_max -report_unconstrained -check_timing_verbose \
        -file [file join $out timing_post_synth.rpt]
    opt_design
    metric phase post_opt
    write_checkpoint [file join $out post_opt.dcp]
    place_design
    metric phase post_place
    write_checkpoint [file join $out post_place.dcp]
    phys_opt_design
    metric phase post_physopt
    write_checkpoint [file join $out post_physopt.dcp]
    route_design
    metric phase post_route
    write_checkpoint [file join $out post_route.dcp]
    set cfu [get_cells -hierarchical -filter {REF_NAME == AgentCfu || ORIG_REF_NAME == AgentCfu}]
    if {[llength $cfu] != 1 || [get_property NAME $cfu] ne $cfu_name} {
        error "AgentCfu hierarchy disappeared/changed during implementation"
    }
    report_utilization -file [file join $out utilization_soc.rpt]
    report_utilization -cells $cfu -file [file join $out utilization_cfu.rpt]
    report_utilization -hierarchical -hierarchical_min_primitive_count 0 \
        -file [file join $out utilization_hierarchical.rpt]
    report_power -hier power -hierarchical_depth 0 -file [file join $out power.rpt]
    report_timing_summary -delay_type min_max -max_paths 20 -report_unconstrained \
        -check_timing_verbose -file [file join $out timing_summary.rpt]
    set checks [check_timing -verbose -return_string]
    save_text [file join $out check_timing.rpt] $checks
    foreach key {unconstrained_internal_endpoints no_clock} {
        metric soc.$key [check_count $checks $key]
    }
    report_route_status -file [file join $out route_status.rpt]
    foreach {key property} {fully_routed ROUTED_FULLY errors_in_routes ERRORS_IN_ROUTES fully_placed PLACED_FULLY} {
        metric route.$key [report_route_status -boolean_check $property]
    }
    report_drc -name ppa_drc -file [file join $out drc.rpt]
    foreach {key severity} {errors Error critical_warnings {Critical Warning} warnings Warning} {
        set count 0
        foreach violation [get_drc_violations -quiet -name ppa_drc] {
            set actual [get_property SEVERITY $violation]
            if {$actual ni {Error {Critical Warning} Warning Advisory Info}} {
                error "Unknown DRC severity: $actual"
            }
            if {$actual eq $severity} { incr count }
        }
        metric drc.$key $count
    }
    # Part-only PPA has no board pin map and never writes a bitstream. Preserve
    # raw DRC severities/counts above; classify ONLY the exact UCIO-1 rule below.
    # The '#' delimiter prevents accidentally matching UCIO-10 or another rule.
    set board_unbound_critical 0
    foreach violation [get_drc_violations -quiet -name ppa_drc UCIO-1#*] {
        if {[get_property SEVERITY $violation] eq "Critical Warning"} {
            incr board_unbound_critical
        }
    }
    metric drc.board_unbound.rule_code UCIO-1
    metric drc.board_unbound.raw_severity {Critical Warning}
    metric drc.board_unbound.scope part_only_no_bitstream
    metric drc.board_unbound.critical_warnings $board_unbound_critical
    timing_metric soc.setup max
    timing_metric soc.hold min
    set cfu_regs {}
    foreach reg [all_registers -cells] {
        if {[string first "${cfu_name}/" [get_property NAME $reg]] == 0} {
            lappend cfu_regs $reg
        }
    }
    set inputs [get_pins -quiet -of_objects $cfu -filter {DIRECTION == IN}]
    set outputs [get_pins -quiet -of_objects $cfu -filter {DIRECTION == OUT}]
    foreach {mode delay} {setup max hold min} {
        if {[llength $cfu_regs] > 0} {
            timing_metric cfu.internal.$mode $delay -from $cfu_regs -to $cfu_regs
        } else { absent_timing cfu.internal.$mode }
        if {[llength $inputs] > 0} {
            timing_metric cfu.entering.$mode $delay -through $inputs
        } else { absent_timing cfu.entering.$mode }
        if {[llength $outputs] > 0} {
            timing_metric cfu.leaving.$mode $delay -through $outputs
        } else { absent_timing cfu.leaving.$mode }
        if {[llength $inputs] > 0 && [llength $outputs] > 0} {
            timing_metric cfu.through.$mode $delay -through $inputs -through $outputs
        } else { absent_timing cfu.through.$mode }
    }
} message options]
if {$result} {
    metric flow.error $message
    save_text [file join $out tcl_error.rpt] [dict get $options -errorinfo]
}
close $metrics
# The driver independently enforces closure and rejects absent/invalid metrics
# even when every vendor command returned TCL_OK.
exit [expr {$result ? 1 : 0}]
